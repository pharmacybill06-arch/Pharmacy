generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// REDESIGNED SCHEMA - ALL FIELDS NORMALIZED
// ============================================
// All invoice data is now stored in individual columns
// Items are in a separate table with proper relationships

// User model: Stores pharmacy app users (patients, staff)
model User {
  id            String  @id @default(cuid())
  email         String? @unique
  name          String?
  phone         String  @unique
  shopName      String? // User's shop/pharmacy name (used to filter from OCR)
  expoPushToken String? // Expo push token for this device, used for refill-reminder alerts

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bills               Bill[]
  products            Product[]
  distributors        Distributor[]
  payments            Payment[]
  sales               Sale[]
  exportLogs          ExportLog[]
  emailConnections    EmailInboxConnection[]
  emailProcessingLogs EmailProcessingLog[]
  patients            Patient[]

  @@index([email])
  @@index([phone])
}

model EmailInboxConnection {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider     String  @default("zoho")
  authType     String  @default("imap_password")
  emailAddress String?
  displayName  String?
  password     String?
  imapHost     String?
  imapPort     Int?    @default(993)
  imapSecure   Boolean @default(true)
  mailbox      String? @default("INBOX")

  accountId       String?
  accessToken     String?
  refreshToken    String?
  clientId        String?
  clientSecret    String?
  apiDomain       String  @default("https://mail.zoho.in")
  accountsBaseUrl String  @default("https://accounts.zoho.in")
  folderId        String?

  isActive       Boolean   @default(true)
  lastSyncedAt   DateTime?
  tokenUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  processingLogs EmailProcessingLog[]

  @@unique([userId, provider])
  @@index([userId, isActive])
}

// Distributor model: Suppliers/Distributors (Bhalla, Laksh, etc.)
// Normalized from pharmacyName field in bills
model Distributor {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ========== DISTRIBUTOR DETAILS ==========
  name     String // Distributor name (e.g., Bhalla Medical)
  address  String? // Full address
  phone    String? // Contact phone
  gstin    String? // GST Identification Number
  dlNumber String? // Drug License Number
  email    String? // Contact email

  // ========== METADATA ==========
  notes    String? // Additional notes
  isActive Boolean @default(true) // Soft delete flag

  // ========== LEDGER (Distributor Payments / Khata) ==========
  openingBalance          Float     @default(0) // Dues that existed before app adoption (from "CURRANT BAL" on printed bill)
  openingBalanceNote      String? // Audit note explaining the last edit to openingBalance
  openingBalanceUpdatedAt DateTime? // When openingBalance was last edited

  // ========== RELATIONSHIPS ==========
  bills    Bill[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name, gstin])
  @@index([userId])
  @@index([name])
  @@index([gstin])
}

// Product model: Unique products catalog for quick billing
// Auto-populated from OCR-parsed BillItems + manual entries
model Product {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ========== PRODUCT IDENTIFICATION ==========
  name           String // Product/medicine name
  nameNormalized String // Normalized name for matching (lowercase, no spaces)
  salt           String? // Salt composition of medicine
  manufacturer   String? // Manufacturer name
  hsnCode        String? // HSN/SAC code for taxation
  batchNumber    String? // DEPRECATED: single-batch field superseded by ProductBatch. Only ever holds the last-synced batch.
  expiryDate     String? // DEPRECATED: superseded by ProductBatch.expiryDate (proper DateTime). Free-text, last-synced batch only.

  // ========== PACK / UNIT DEFINITION ==========
  // All stock math happens in base units; packs are a display conversion only.
  packSize  Int    @default(1) // Base units per pack (1 strip = 15 tablets -> 15)
  baseUnit  String @default("unit") // tablet, ml, unit, capsule
  packLabel String @default("pack") // strip, bottle, vial, tube

  // ========== REGULATORY ==========
  scheduleFlag String @default("none") // none | h1 | nrx — h1/nrx force a billed sale with customer + doctor

  // ========== INVENTORY ==========
  quantity     Float? // Current quantity in stock
  purchaseDate String? // Purchase date (dd-mm-yyyy format)
  // DERIVED display value = SUM(batches.quantityBase). Sales code must never write to it;
  // it deducts from ProductBatch.quantityBase instead.
  stock        Float   @default(0)
  minStock     Float? // Alert threshold for low stock
  unit         String  @default("units") // tabs, bottle, ml, etc.

  // ========== DEFAULT PRICING ==========
  defaultMrp   Float? // Default MRP
  defaultRate  Float? // Default selling rate
  mrp          Float? // MRP per unit
  purchaseRate Float? // Purchase rate per unit
  sellingRate  Float? // Selling rate per unit
  ptr          Float? // PTR (Price to Retailer)
  gstPercent   Float? // Default GST percentage

  // ========== USAGE TRACKING ==========
  usageCount Int       @default(0) // Times used in bills
  lastUsedAt DateTime? // Last time used in a bill

  // ========== METADATA ==========
  notes    String? // Additional notes
  isActive Boolean @default(true) // Soft delete flag

  // ========== MERGE (Merge Products tool) ==========
  // Set when this product was merged into another (a duplicate catalog entry, e.g. the
  // same drug created twice from two distributors' differently-worded OCR text). Archive,
  // never delete: the row stays queryable/traceable, isActive flips to false, and every
  // batch/bill/sale reference is remapped to mergedInto at merge time.
  mergedIntoProductId String?
  mergedInto           Product?  @relation("ProductMergeHistory", fields: [mergedIntoProductId], references: [id], onDelete: SetNull)
  mergedFrom           Product[] @relation("ProductMergeHistory")
  mergedAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ========== RELATIONSHIPS ==========
  billItems BillItem[]
  batches   ProductBatch[]
  saleItems SaleItem[]

  @@unique([userId, nameNormalized])
  @@index([userId])
  @@index([name])
  @@index([nameNormalized])
  @@index([lastUsedAt])
  @@index([expiryDate])
  @@index([scheduleFlag])
  @@index([mergedIntoProductId])
}

// ProductBatch: batch-level stock — the unit of truth for FEFO picking and recall traceability.
// Replaces the single Product.batchNumber/expiryDate/stock triple, which could only ever
// describe the most recently synced batch.
model ProductBatch {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Stored EXACTLY as entered/extracted. Never auto-corrected, auto-filled or "cleaned"
  // by any AI/OCR step — a user free-text override is always available.
  batchNumber String

  // trim().toLowerCase() of batchNumber — matching/dedup key only, never displayed.
  // Postgres unique constraints are case-sensitive by default, so without this a
  // case/whitespace variant of the same physical batch (e.g. OCR read once as "V2600095"
  // and once as "v2600095 ") would silently create a second ProductBatch row instead of
  // topping up the existing one.
  batchNumberNormalized String

  // Proper date type. Month-only inputs ("8/26") are parsed to the last day of that month.
  expiryDate DateTime?

  // Stock in BASE units (tablets/ml/pieces), never strips. May go negative: a stock
  // mismatch warns the pharmacist but never blocks a real sale at the counter.
  quantityBase Float @default(0)

  purchaseRate Float? // From the purchase bill item, for margin reporting later
  mrp          Float?

  // Traceability: which purchase line created this batch
  sourceBillItemId String?
  sourceBillItem   BillItem? @relation(fields: [sourceBillItemId], references: [id], onDelete: SetNull)

  isArchived Boolean @default(false) // Archive, never delete

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleItems SaleItem[]

  @@unique([productId, batchNumberNormalized])
  @@index([productId, expiryDate])
  @@index([sourceBillItemId])
}

// Sale: one counter sale. "quick" = recorded in seconds and billed later; "billed" = has a Bill.
model Sale {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  saleDate DateTime @default(now())
  status   String   @default("quick") // quick (unbilled) | billed

  // Set when converted to a Bill (billType = "sale")
  billId String? @unique
  bill   Bill?   @relation(fields: [billId], references: [id], onDelete: SetNull)

  // Mandatory only for Schedule H1 / NRX sales
  customerName String?
  doctorName   String?

  customerPhone String?
  totalAmount   Float? // Optional in quick mode

  isArchived Boolean   @default(false) // Archive, never delete — archiving restores stock
  archivedAt DateTime?
  notes      String?

  items SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, saleDate])
  @@index([userId, status])
  @@index([isArchived])
}

// SaleItem: one line of a sale, always pinned to the exact physical batch it came from.
model SaleItem {
  id     String @id @default(cuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Mandatory. Every sale line knows its exact batch — the recall-traceability hook.
  // Restrict on delete so a sold-from batch can never be removed out from under history.
  productBatchId String
  productBatch   ProductBatch @relation(fields: [productBatchId], references: [id], onDelete: Restrict)

  quantityBase Float // In base units (tablets) — supports loose sale
  pricePerBase Float? // Optional in quick mode

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([productId])
  @@index([productBatchId])
}

// OTP model: Stores OTPs for phone verification
model Otp {
  id        String   @id @default(cuid())
  phone     String
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)

  createdAt DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
}

// Bill model: Main invoice/bill record with all extracted fields
model Bill {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ========== BILL TYPE ==========
  billType String @default("purchase") // purchase (from distributor) or sale (to customer)

  // ========== DISTRIBUTOR RELATION ==========
  distributorId String?
  distributor   Distributor? @relation(fields: [distributorId], references: [id], onDelete: SetNull)

  // ========== FILE STORAGE ==========
  fileName String
  filePath String
  fileSize Int
  mimeType String

  // ========== PHARMACY DETAILS (DEPRECATED - Use Distributor) ==========
  pharmacyName String? // LEGACY: Kept for backward compatibility
  shopAddress  String? // Full shop address
  phoneNumbers String? // JSON array of phone numbers

  // ========== INVOICE IDENTIFICATION ==========
  invoiceNumber String?
  invoiceDate   DateTime?
  dueDate       DateTime? // Ledger: drives overdue logic (user-entered or extracted)

  // ========== CUSTOMER DETAILS ==========
  customerName    String?
  customerPhone   String?
  customerAddress String?
  doctorName      String?

  // ========== FINANCIAL TOTALS ==========
  subtotal Float? // Sum of all items before tax/discount

  // Tax breakdown
  cgst     Float? // Central GST amount
  sgst     Float? // State GST amount
  totalGst Float? // Total GST (CGST + SGST)

  // Discounts and adjustments
  discountAmount Float? // Total discount applied
  roundOff       Float? // Round-off adjustment

  grandTotal Float? // Final payable amount

  // ========== PAYMENT DETAILS ==========
  paymentType   String? // cash, credit, card, upi, etc.
  amountPaid    Float? // Amount actually paid
  balanceAmount Float? // Remaining balance

  // ========== ADDITIONAL INFO ==========
  remarks String? // Any special notes or remarks

  // ========== OCR & PROCESSING ==========
  status     String  @default("uploaded") // uploaded, processing, completed, failed
  rawOcrText String? // Raw text extracted from OCR

  // Processing metadata
  ocrEngine   String? // ml-kit, tesseract, etc.
  aiParser    String? // gemini-ai, groq, etc.
  processedAt DateTime? // When AI parsing was completed

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ========== RELATIONSHIPS ==========
  items       BillItem[]
  allocations PaymentAllocation[] // Ledger: payments (or partial payments) settling this bill
  sale        Sale? // Set when this bill was created by converting a quick sale (billType = "sale")
  editLogs    BillEditLog[] // Audit trail — archive-never-delete, one row per field per edit

  @@index([userId])
  @@index([billType])
  @@index([distributorId])
  @@index([status])
  @@index([invoiceDate])
  @@index([dueDate])
  @@index([pharmacyName])
  @@index([invoiceNumber])
}

// BillEditLog: append-only audit trail for edits to an already-saved Bill/BillItem.
// One row per changed field per edit — archive-never-delete applies to history, so this
// table is only ever inserted into, never updated or deleted.
model BillEditLog {
  id     String @id @default(cuid())
  billId String
  bill   Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)

  // Set when the edit was to a specific line item; null = bill header edit
  billItemId String?
  billItem   BillItem? @relation(fields: [billItemId], references: [id], onDelete: SetNull)

  field    String // e.g. "invoiceDate", "batchNumber", "quantity", "distributorId"
  oldValue String? // stringified before value
  newValue String? // stringified after value
  note     String? // optional context, e.g. a stock-mismatch warning raised by a qty edit

  editedAt DateTime @default(now())

  @@index([billId, editedAt])
  @@index([billItemId])
}

// Payment model: Track payments made to distributors via UPI (Google Pay, PhonePe, Paytm, etc.)
// Captures shared payment receipts from UPI apps
model Payment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ========== DISTRIBUTOR LINK ==========
  distributorId String?
  distributor   Distributor? @relation(fields: [distributorId], references: [id], onDelete: SetNull)

  // ========== TRANSACTION DETAILS ==========
  transactionId String? // UPI Transaction ID / UTR Number
  upiRefNumber  String? // UPI Reference Number
  amount        Float // Amount paid
  payeeName     String? // Payee name from UPI receipt
  payeeUpiId    String? // Payee UPI ID (e.g., merchant@upi)
  payerName     String? // Payer name
  payerUpiId    String? // Payer UPI ID

  // ========== PAYMENT INFO ==========
  paymentApp    String? // google_pay, phonepe, paytm, etc.
  paymentMethod String    @default("upi") // upi, neft, rtgs, cash, cheque
  paymentDate   DateTime? // Date of the actual payment
  paymentStatus String    @default("success") // success, pending, failed

  // ========== RAW DATA ==========
  rawSharedText  String? // Raw text received from share intent
  screenshotPath String? // Path to payment screenshot/receipt photo (ledger: "attachment_path")

  // ========== LEDGER (Distributor Payments / Khata) ==========
  referenceNumber  String? // Generic ref: UPI ref / UTR / cheque no / credit note no
  attachmentSource String? // gallery | camera
  isArchived       Boolean   @default(false) // Archive only — never hard-delete once allocated
  archivedAt       DateTime?

  // ========== NOTES ==========
  notes String? // User notes about the payment

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ========== RELATIONSHIPS ==========
  allocations PaymentAllocation[]

  @@unique([transactionId, userId]) // Prevent duplicate transaction entries
  @@index([userId])
  @@index([distributorId])
  @@index([paymentDate])
  @@index([transactionId])
  @@index([paymentApp])
  @@index([isArchived])
}

// PaymentAllocation: Join table between Payment and Bill (ledger reconciliation)
// A payment can settle multiple bills; a bill can be settled by multiple partial payments.
// billId is null for the two "virtual" allocation targets: opening_balance and on_account (unallocated advance).
model PaymentAllocation {
  id String @id @default(cuid())

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  billId String?
  bill   Bill?   @relation(fields: [billId], references: [id], onDelete: Cascade)

  allocationType  String @default("bill") // bill | opening_balance | on_account
  allocatedAmount Float

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([billId])
}

// BillItem model: Individual line items from invoice (medicines, products)
model BillItem {
  id     String @id @default(cuid())
  billId String
  bill   Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)

  // ========== PRODUCT LINK ==========
  productId String? // Link to Product catalog (optional)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // ========== ITEM IDENTIFICATION ==========
  serialNumber Int? // S.N. from bill
  name         String // Medicine/product name
  manufacturer String? // Manufacturer name

  // ========== BATCH & EXPIRY ==========
  batchNumber String? // Batch number
  expiryDate  String? // Expiry date (stored as string as it varies in format)
  hsnCode     String? // HSN/SAC code for taxation

  // ========== QUANTITY ==========
  quantity     Float // Quantity purchased
  freeQuantity Float? // Free quantity (offers)
  unit         String @default("units") // tabs, caps, ml, bottle, sachet, etc. — legacy display string, superseded by the trio below

  // ========== DUAL-UNIT CAPTURE (Unit 1 / Unit 2 / conversion) ==========
  // Auto-suggested from the extracted name/pack string ("TAB 20*10" -> strip/tablet/10),
  // confirmed/edited by the user at bill-confirm time. Null on older bills saved before
  // this existed. Feeds Product.packLabel/baseUnit/packSize on first sync for a new
  // product — see productService.syncProductsFromBillItems.
  packLabel String? // Unit 1 — strip, bottle, vial, tube, box, sachet, kit, pack
  baseUnit  String? // Unit 2 — tablet, capsule, ml, gm, respule, ampoule, piece
  packSize  Int? // conversion: 1 packLabel = packSize baseUnit

  // ========== PRICING ==========
  mrp  Float? // Maximum Retail Price per unit
  rate Float  @default(0) // Legacy price field; expiry management does not use it

  // ========== TAXES ==========
  gstPercent  Float? // Overall GST percentage
  cgstPercent Float? // CGST percentage
  sgstPercent Float? // SGST percentage

  // ========== DISCOUNT ==========
  discount Float? // Discount on this item

  // ========== TOTALS ==========
  itemTotal Float @default(0) // Legacy total field; expiry management does not use it

  // ========== EXPIRY ACTION MANAGEMENT ==========
  remainingQty         Float? // Manually entered remaining stock (Phase 2: auto from sales)
  expiryStatus         String    @default("active") // active | archived
  archiveReason        String? // sold | returned | writeoff | expired
  archivedAt           DateTime? // When it was archived
  firstEnteredWindowAt DateTime? // When it first entered the action window

  // ========== METADATA ==========
  confidence       Float?  @default(1.0) // OCR confidence (0-1)
  isProductMatched Boolean @default(false) // Whether linked to product catalog

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ========== RELATIONSHIPS ==========
  createdBatches ProductBatch[] // Batches this purchase line brought into stock
  editLogs       BillEditLog[] // Audit trail for edits to this line item

  @@index([billId])
  @@index([productId])
  @@index([name])
  @@index([expiryStatus])
}

// EmailProcessingLog: Tracks Zoho emails that have been processed (prevents re-processing)
model EmailProcessingLog {
  id           String                @id @default(cuid())
  userId       String?
  user         User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId String?
  connection   EmailInboxConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  messageId    String // Zoho Mail message ID
  subject      String?
  sender       String?
  folderId     String?
  emailDate    DateTime?
  attachments  Int                   @default(0) // Number of attachments processed
  billsCreated Int                   @default(0) // How many bills were saved
  status       String                @default("processed") // processed, failed, skipped
  errorMessage String?
  processedAt  DateTime              @default(now())

  @@unique([connectionId, messageId])
  @@index([userId])
  @@index([messageId])
  @@index([processedAt])
}

// Patient model: Chronic patients tracked for refill reminders / medication sync
model Patient {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  phone    String
  notes    String?
  isActive Boolean @default(true) // Soft delete flag

  medicines PatientMedicine[]
  reminders ReminderLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, phone])
  @@index([userId])
}

// PatientMedicine: One chronic medicine a patient is on, used to compute days-of-supply/run-out
model PatientMedicine {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  dosageForm      String   @default("tablet")
  dosageDetails   Json?
  name            String // Medicine name (matched against Product for stock flag)
  stripsDispensed Float // Strips dispensed at last fill
  tabletsPerStrip Float // Tablets per strip
  dosePerDay      Float // Tablets taken per day
  lastFillDate    DateTime @default(now()) // Cycle start; reset by Confirm Pickup

  isActive Boolean @default(true) // Soft delete flag

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
}

// ReminderLog: Record of refill reminders sent to a patient (mock channel in v1)
model ReminderLog {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  channel    String   @default("manual") // manual (mock), whatsapp, call, push
  medicineId String? // set for 'push' low-stock alerts, used to dedup per medicine per day
  sentAt     DateTime @default(now())

  @@index([patientId])
  @@index([medicineId])
}

// ExportLog: audit trail of data exports. Files are generated on demand and streamed
// straight to the user — nothing is stored server-side, so this is the only record
// that an export happened.
model ExportLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  exportType String // purchases | expiry | sales | ledger
  format     String @default("xlsx") // xlsx | csv
  filters    Json? // The filter set used, for support/debugging
  rowCount   Int    @default(0)
  fileName   String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([exportType])
}

// BillDetectionCache: Cache AI detection results to reduce API calls
// Caches based on subject/sender patterns to avoid re-analyzing similar emails
model BillDetectionCache {
  id         String    @id @default(cuid())
  cacheKey   String    @unique // Hash of normalized subject + sender
  subject    String? // Original subject (for debugging)
  sender     String? // Original sender (for debugging)
  isBill     Boolean // Detection result
  confidence Float // Confidence score (0-1)
  reason     String? // Detection reason
  billType   String // body-text, attachment, both, none
  hitCount   Int       @default(1) // Number of cache hits
  lastHitAt  DateTime  @default(now()) // Last time this cache was used
  createdAt  DateTime  @default(now())
  expiresAt  DateTime? // Optional expiration (for cleanup)

  @@index([cacheKey])
  @@index([expiresAt])
  @@index([lastHitAt])
}
