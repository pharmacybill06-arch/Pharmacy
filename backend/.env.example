# =====================================================
# PharmaBooks Backend - Environment Variables
# Copy this to .env and fill in your values
# =====================================================

# Server
PORT=5000
NODE_ENV=development

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&connection_limit=5&connect_timeout=30&pool_timeout=30

# AI (OpenAI is the only provider — bill parsing and product identification)
OPENAI_API_KEY=your_openai_api_key_here
# Optional model overrides.
# Benchmarked on a 10-item GST invoice (scripts/1000022504.png), scored against the
# printed values by hand — item fields correct out of 40, and cost for the whole scan:
#   gpt-4.1-mini  38/40  ~Rs 0.35   <- default
#   gpt-4o        27/40  ~Rs 1.60
#   gpt-4o-mini   19/40  ~Rs 1.80   (mangles the QTY column - do not use)
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TEXT_MODEL=gpt-4o-mini

# Bill-scan cost controls
# Item-table double read: auto (2nd pass only when the 1st looks shaky) | always | never
OPENAI_ITEM_DOUBLE_READ=auto
# Max chars of OCR hint pasted into each vision prompt (it is paid for once per pass)
OPENAI_VISION_HINT_MAX_CHARS=4000
# Used only for the per-scan cost figures printed in the logs
USD_TO_INR=88
GROQ_API_KEY=your_groq_api_key_here

# OCR (optional fallback)
OCR_API_KEY=your_ocr_space_api_key_here

# Security
JWT_SECRET=your_64_char_random_secret_here
