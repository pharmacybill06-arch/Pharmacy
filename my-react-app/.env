# Backend API URL — must point at the SAME backend as the mobile app's
# EXPO_PUBLIC_BACKEND_URL in frontend/.env, or the two clients show different data.
#
# localhost works when you run the web app on the same machine as the backend.
# Use the LAN IP (as mobile does) if you open the web app from another device,
# and the Render URL for a deployed build.
REACT_APP_BACKEND_URL=http://localhost:5000/api
# REACT_APP_BACKEND_URL=http://192.168.68.18:5000/api
# REACT_APP_BACKEND_URL=https://pharmacy-nlhp.onrender.com/api
