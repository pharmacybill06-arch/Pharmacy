# =====================================================
# PharmaBooks Frontend - Production Environment
# Copy to .env.production.local and fill in your values
# OR set these in Netlify/Vercel dashboard instead
# =====================================================

# Your deployed backend URL (no trailing slash)
# Example: https://pharmabooks-backend.onrender.com/api
REACT_APP_BACKEND_URL=https://your-backend.onrender.com/api

# Disables source maps in production build (smaller bundle)
GENERATE_SOURCEMAP=false

# Set to false so lint warnings don't fail the CI build
CI=false
