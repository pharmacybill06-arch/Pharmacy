{
  "expo": {
    "name": "pharmacy-bill-app",
    "slug": "pharmacy-bill-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.pharmacybillapp",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs camera access to scan pharmacy bills and extract text",
        "NSPhotoLibraryUsageDescription": "This app needs photo library access to select bill images for scanning"
      }
    },
    "android": {
      "package": "com.yourcompany.pharmacybillapp",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*",
            "image/*"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to scan pharmacy bills"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to select bill images"
        }
      ],
      "expo-secure-store",
      "expo-document-picker",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "EXPO_PUBLIC_ENABLE_GEMINI": true,
      "eas": {
        "projectId": "80d2ae2d-e764-4692-9a10-1e768c35b713"
      }
    },
    "owner": "setupharma"
  }
}
