{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "backend",
        "start"
      ],
      "port": 5000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "my-react-app",
        "start"
      ],
      "port": 3000
    },
    {
      "name": "mobile",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd frontend && set \"CI=true\" && npx expo start --clear --port 8081 --max-workers 2"
      ],
      "port": 8081
    }
  ]
}
